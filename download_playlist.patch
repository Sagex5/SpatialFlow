+package com.codetrio.spatialflow.data.lyrics.providers
+
+import android.util.Log
+import com.codetrio.spatialflow.data.lyrics.LyricsNormalizer
+import com.codetrio.spatialflow.data.lyrics.LyricsResult
+import com.codetrio.spatialflow.data.lyrics.TrackMetadata
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import org.json.JSONObject
+import java.net.URLEncoder
+import kotlin.math.abs
+
+/**
+ * NetEase Cloud Music — large catalogue with line-synced (LRC) lyrics, no API key needed.
+ */
+class NetEaseLyricsProvider(private val client: OkHttpClient) : LyricsProvider {
+
+    companion object {
+        private const val TAG = "NetEaseLyrics"
+    }
+
+    override fun getName(): String = "NetEase"
+
+    override fun getPriority(): Int = 3
+
+    override fun search(track: TrackMetadata): LyricsResult? {
+        val keyword = "${track.cleanedArtist} ${track.cleanedTitle}".trim()
+        if (keyword.isBlank()) return null
+
+        try {
+            val songs = getJson(
+                "https://music.163.com/api/search/get?s=${enc(keyword)}&type=1&limit=8&offset=0"
+            )?.optJSONObject("result")?.optJSONArray("songs") ?: return null
+
+            for (i in 0 until songs.length()) {
+                val song = songs.optJSONObject(i) ?: continue
+                val id = song.optLong("id")
+                val name = song.optString("name")
+                val durationMs = song.optLong("duration")
+                if (id == 0L || !isGoodMatch(track, name, durationMs)) continue
+
+                val artists = song.optJSONArray("artists")
+                val singer = buildString {
+                    if (artists != null) {
+                        for (a in 0 until artists.length()) {
+                            val artistName = artists.optJSONObject(a)?.optString("name").orEmpty()
+                            if (artistName.isNotBlank()) {
+                                if (isNotEmpty()) append(", ")
+                                append(artistName)
+                            }
+                        }
+                    }
+                }
+
+                val lrcText = getJson("https://music.163.com/api/song/lyric?id=$id&lv=-1&kv=-1&tv=-1")
+                    ?.optJSONObject("lrc")?.optString("lyric")
+                if (lrcText.isNullOrBlank()) continue
+                val lrc = keepTimedLines(lrcText) ?: continue
+
+                val result = LyricsResult(
+                    providerName = getName(),
+                    matchedTitle = name,
+                    matchedArtist = singer,
+                    matchedDuration = durationMs / 1000f
+                )
+                result.setSyncedLyrics(lrc)
+                if (result.isSynced) return result
+            }
+        } catch (e: Exception) {
+            Log.w(TAG, "Search failed: ${e.message}")
+        }
+        return null
+    }
+
+    private fun isGoodMatch(track: TrackMetadata, name: String, durationMs: Long): Boolean {
+        if (LyricsNormalizer.similarity(track.cleanedTitle, name) < 0.6f) return false
+        return track.durationMs <= 0 || durationMs <= 0 || abs(track.durationMs - durationMs) <= 8000L
+    }
+
+    private fun getJson(url: String): JSONObject? {
+        val request = Request.Builder()
+            .url(url)
+            .header("User-Agent", "Mozilla/5.0 (Linux; Android 14) AppleWebKit/537.36 Chrome/120 Mobile Safari/537.36")
+            .header("Referer", "https://music.163.com")
+            .header("Cookie", "appver=2.0.2")
+            .build()
+        client.newCall(request).execute().use { response ->
+            if (!response.isSuccessful) return null
+            val body = response.body.string()
+            if (body.isBlank()) return null
+            return JSONObject(body)
+        }
+    }
+
+    private fun enc(value: String): String = URLEncoder.encode(value, "UTF-8")
+}
