+
+@Composable
+private fun DockItem(
+    visible: Boolean,
+    index: Int,
+    content: @Composable () -> Unit
+) {
+    AnimatedVisibility(
+        visible = visible,
+        enter = fadeIn(tween(180, delayMillis = index * 40)) +
+            scaleIn(spring(dampingRatio = Spring.DampingRatioMediumBouncy), initialScale = 0.6f) +
+            expandHorizontally(),
+        exit = fadeOut(tween(100)) + scaleOut(targetScale = 0.6f) + shrinkHorizontally()
+    ) {
+        content()
+    }
+}
+
+@Composable
+private fun DockButton(
+    active: Boolean,
+    activeColor: Color,
+    activeContent: Color,
+    idleContent: Color,
+    description: String,
+    onClick: () -> Unit,
+    size: androidx.compose.ui.unit.Dp = 44.dp,
+    icon: @Composable (Color) -> Unit
+) {
+    val background by animateColorAsState(
+        targetValue = if (active) activeColor else Color.Transparent,
+        label = "DockButtonBackground"
+    )
+    val tint by animateColorAsState(
+        targetValue = if (active) activeContent else idleContent,
+        label = "DockButtonTint"
+    )
+    val interactionSource = remember { MutableInteractionSource() }
+    val isPressed by interactionSource.collectIsPressedAsState()
+    val scale by animateFloatAsState(
+        targetValue = if (isPressed) 0.86f else 1f,
+        animationSpec = spring(dampingRatio = Spring.DampingRatioMediumBouncy, stiffness = Spring.StiffnessMedium),
+        label = "DockButtonScale"
+    )
+
+    Box(
+        modifier = Modifier
+            .size(size)
+            .graphicsLayer {
+                scaleX = scale
+                scaleY = scale
+            }
+            .clip(CircleShape)
+            .background(background)
+            .clickable(
+                interactionSource = interactionSource,
+                indication = null,
+                onClickLabel = description,
+                role = Role.Button,
+                onClick = onClick
+            ),
+        contentAlignment = Alignment.Center
+    ) {
+        icon(tint)
+    }
+}
