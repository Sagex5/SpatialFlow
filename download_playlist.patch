+    /**
+     * Downloads every online song in [songs] one after another (sequential, so we don't
+     * hammer the network or the FFmpeg packager). Local songs and songs that are already
+     * downloaded or currently downloading are skipped.
+     */
+    fun downloadSongs(context: Context, songs: List<SongItem>) {
+        val appContext = context.applicationContext
+        scope.launch {
+            val pending = songs
+                .filter { !it.videoId.isNullOrEmpty() }
+                .distinctBy { it.videoId }
+                .filter { !_downloadProgress.value.containsKey(it.videoId) && !isSongDownloaded(appContext, it) }
+
+            if (pending.isEmpty()) {
+                withContext(Dispatchers.Main) {
+                    com.codetrio.spatialflow.ui.SnackbarController.showMessage("Everything in this playlist is already downloaded")
+                }
+                return@launch
+            }
+
+            withContext(Dispatchers.Main) {
+                com.codetrio.spatialflow.ui.SnackbarController.showMessage("Downloading ${pending.size} songs...")
+            }
+
+            for (song in pending) {
+                performDownload(appContext, song, song.videoId!!)
+            }
+
+            withContext(Dispatchers.Main) {
+                com.codetrio.spatialflow.ui.SnackbarController.showMessage(
+                    "Playlist download finished",
+                    iconResId = R.drawable.ic_downloaded
+                )
+            }
+        }
+    }
