+package com.codetrio.spatialflow.data.lyrics.providers
+
+import android.util.Base64
+import android.util.Log
+import com.codetrio.spatialflow.data.lyrics.LyricsNormalizer
+import com.codetrio.spatialflow.data.lyrics.LyricsResult
+import com.codetrio.spatialflow.data.lyrics.TrackMetadata
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import org.json.JSONObject
+import java.net.URLEncoder
+import kotlin.math.abs
+
+/**
+ * KuGou — large catalogue with line-synced (LRC) lyrics, no API key needed.
+ * Flow: search song -> search lyric candidates -> download LRC (base64).
+ */
+class KuGouLyricsProvider(private val client: OkHttpClient) : LyricsProvider {
+
+    companion object {
+        private const val TAG = "KuGouLyrics"
+    }
+
+    override fun getName(): String = "KuGou"
+
+    override fun getPriority(): Int = 3
+
+    override fun search(track: TrackMetadata): LyricsResult? {
+        val keyword = "${track.cleanedArtist} ${track.cleanedTitle}".trim()
+        if (keyword.isBlank()) return null
+
+        try {
+            val songs = getJson(
+                "https://mobileservice.kugou.com/api/v3/search/song?version=9108&plat=0&pagesize=8&showtype=0&keyword=${enc(keyword)}"
+            )?.optJSONObject("data")?.optJSONArray("info") ?: return null
+
+            for (i in 0 until songs.length()) {
+                val song = songs.optJSONObject(i) ?: continue
+                val name = song.optString("songname")
+                val singer = song.optString("singername")
+                val durationSec = song.optLong("duration")
+                val hash = song.optString("hash")
+                if (hash.isBlank() || !isGoodMatch(track, name, durationSec)) continue
+
+                val lrc = fetchLrc(keyword, hash, durationSec * 1000L) ?: continue
+                val result = LyricsResult(
+                    providerName = getName(),
+                    matchedTitle = name,
+                    matchedArtist = singer,
+                    matchedDuration = durationSec.toFloat()
+                )
+                result.setSyncedLyrics(lrc)
+                if (result.isSynced) return result
+            }
+        } catch (e: Exception) {
+            Log.w(TAG, "Search failed: ${e.message}")
+        }
+        return null
+    }
+
+    private fun fetchLrc(keyword: String, hash: String, durationMs: Long): String? {
+        val candidates = getJson(
+            "https://lyrics.kugou.com/search?ver=1&man=yes&client=pc&keyword=${enc(keyword)}&duration=$durationMs&hash=$hash"
+        )?.optJSONArray("candidates") ?: return null
+        if (candidates.length() == 0) return null
+
+        val candidate = candidates.optJSONObject(0) ?: return null
+        val id = candidate.optString("id")
+        val accessKey = candidate.optString("accesskey")
+        if (id.isBlank() || accessKey.isBlank()) return null
+
+        val content = getJson(
+            "https://lyrics.kugou.com/download?ver=1&client=pc&id=$id&accesskey=$accessKey&fmt=lrc&charset=utf8"
+        )?.optString("content") ?: return null
+        if (content.isBlank()) return null
+
+        val text = String(Base64.decode(content, Base64.DEFAULT), Charsets.UTF_8)
+        return keepTimedLines(text)
+    }
+
+    private fun isGoodMatch(track: TrackMetadata, name: String, durationSec: Long): Boolean {
+        // KuGou names are often "Artist - Title"
+        val similarity = maxOf(
+            LyricsNormalizer.similarity(track.cleanedTitle, name),
+            LyricsNormalizer.similarity(track.cleanedTitle, name.substringAfter(" - "))
+        )
+        if (similarity < 0.6f) return false
+        val targetSec = track.durationMs / 1000L
+        return targetSec <= 0 || durationSec <= 0 || abs(targetSec - durationSec) <= 8
+    }
+
+    private fun getJson(url: String): JSONObject? {
+        val request = Request.Builder()
+            .url(url)
+            .header("User-Agent", "Mozilla/5.0 (Linux; Android 14) AppleWebKit/537.36 Chrome/120 Mobile Safari/537.36")
+            .build()
+        client.newCall(request).execute().use { response ->
+            if (!response.isSuccessful) return null
+            val body = response.body.string()
+            if (body.isBlank()) return null
+            return JSONObject(body)
+        }
+    }
+
+    private fun enc(value: String): String = URLEncoder.encode(value, "UTF-8")
+}
+
+/** Keeps only the "[mm:ss.xx] text" lines of an LRC file (drops header/credit tags). */
+internal fun keepTimedLines(raw: String): String? {
+    val regex = Regex("^\\[\\d{2}:\\d{2}\\.\\d{2,3}].*")
+    val lines = raw.replace("\uFEFF", "").replace("\r", "").lines().filter { regex.matches(it.trim()) }
+    return if (lines.size >= 3) lines.joinToString("\n") { it.trim() } else null
+}
