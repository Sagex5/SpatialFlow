+
+/** Ids of items that come from the device (downloads / local playlists) instead of YouTube Music. */
+const val OFFLINE_ID_PREFIX = "local:"
+
+fun isOfflineId(id: String?): Boolean = id?.startsWith(OFFLINE_ID_PREFIX) == true
+
+/**
+ * The home feed's sections, filled with downloaded songs and playlists instead of online
+ * content. It reuses the normal home layout, so the screen looks the same offline as online.
+ */
+class OfflineHome(
+    val sections: List<HomeSection>,
+    private val allSongs: List<SongItem>,
+    private val playlistSongs: Map<String, List<SongItem>>
+) {
+    fun playSong(viewModel: PlayerSharedViewModel, song: OnlineSong) {
+        val localId = song.videoId.removePrefix(OFFLINE_ID_PREFIX).toLongOrNull() ?: return
+        val index = allSongs.indexOfFirst { it.id == localId }
+        if (index < 0) return
+        viewModel.setSongList(allSongs)
+        viewModel.playSongAtIndex(index)
+    }
+
+    fun playPlaylist(viewModel: PlayerSharedViewModel, playlist: OnlinePlaylist) {
+        val songs = playlistSongs[playlist.playlistId] ?: return
+        if (songs.isEmpty()) return
+        viewModel.setSongList(songs)
+        viewModel.playSongAtIndex(0)
+    }
+}
+
+/**
+ * Builds the offline home content while [enabled] (feed empty and not loading).
+ * Rebuilds when a download starts or finishes.
+ */
+@Composable
+fun rememberOfflineHome(enabled: Boolean): OfflineHome? {
+    val appContext = LocalContext.current.applicationContext
+    val downloadProgress by SongDownloader.downloadProgress.collectAsStateWithLifecycle()
+    var home by remember { mutableStateOf<OfflineHome?>(null) }
+
+    LaunchedEffect(enabled, downloadProgress.isEmpty()) {
+        home = if (enabled) {
+            withContext(Dispatchers.IO) { buildOfflineHome(appContext) }
+        } else {
+            null
+        }
+    }
+    return home
+}
+
+private suspend fun buildOfflineHome(context: Context): OfflineHome? {
+    val songs = loadDownloadedSongs(context)
+
+    // Library playlists, keeping only the songs that are downloaded on this device
+    val playlistSongs = LinkedHashMap<String, List<SongItem>>()
+    val playlistCards = ArrayList<SearchItem>()
+    try {
+        val dao = MusicDatabase.getDatabase(context).playlistDao()
+        for (playlist in dao.getAllPlaylists().first()) {
+            val matched = dao.getSongsForPlaylist(playlist.id).first().mapNotNull { entity ->
+                entity.songId.toLongOrNull()?.let { id -> songs.firstOrNull { it.id == id } }
+                    ?: songs.firstOrNull { titlesMatch(it.title, entity.title) }
+            }.distinctBy { it.id }
+            if (matched.isEmpty()) continue
+
+            val playlistId = "$OFFLINE_ID_PREFIX${playlist.id}"
+            playlistSongs[playlistId] = matched
+            playlistCards.add(
+                SearchItem.Playlist(
+                    OnlinePlaylist(
+                        playlistId = playlistId,
+                        title = playlist.title,
+                        songCount = "${matched.size} songs",
+                        thumbnailUrl = matched.first().getAlbumArtUri()?.toString()
+                    )
+                )
+            )
+        }
+    } catch (_: Exception) {
+    }
+
+    if (songs.isEmpty() && playlistCards.isEmpty()) return null
+
+    val sections = ArrayList<HomeSection>()
+    if (songs.isNotEmpty()) {
+        sections.add(HomeSection("Quick picks", songs.take(12).map { it.toOfflineItem() }))
+        if (songs.size >= 5) {
+            sections.add(HomeSection("Your Personalized Mix", songs.shuffled().take(5).map { it.toOfflineItem() }))
+        }
+    }
+    if (playlistCards.isNotEmpty()) {
+        sections.add(HomeSection("Your playlists", playlistCards))
+    }
+    if (songs.size > 12) {
+        sections.add(HomeSection("Downloaded music", songs.drop(12).take(40).map { it.toOfflineItem() }))
+    }
+    return OfflineHome(sections, songs, playlistSongs)
+}
+
+private fun SongItem.toOfflineItem(): SearchItem = SearchItem.Song(
+    OnlineSong(
+        videoId = "$OFFLINE_ID_PREFIX$id",
+        title = title,
+        artist = artist,
+        durationMs = duration,
+        thumbnailUrl = getAlbumArtUri()?.toString()
+    )
+)
+
+private fun normalize(text: String): String = text.lowercase().filter { it.isLetterOrDigit() }
+
+private fun titlesMatch(localTitle: String, playlistTitle: String): Boolean {
+    val a = normalize(localTitle)
+    val b = normalize(playlistTitle)
+    if (a.isEmpty() || b.isEmpty()) return false
+    if (a == b) return true
+    return minOf(a.length, b.length) >= 4 && (a.contains(b) || b.contains(a))
+}
+
+/** Reads the app's downloaded songs (the Music/SpatialFlow folder) from MediaStore, newest first. */
+private fun loadDownloadedSongs(context: Context): List<SongItem> {
+    val songs = ArrayList<SongItem>()
+    try {
+        val projection = arrayOf(
+            MediaStore.Audio.Media._ID,
+            MediaStore.Audio.Media.TITLE,
+            MediaStore.Audio.Media.ARTIST,
+            MediaStore.Audio.Media.ALBUM_ID,
+            MediaStore.Audio.Media.DATA,
+            MediaStore.Audio.Media.DURATION,
+            MediaStore.Audio.Media.DATE_ADDED
+        )
+        context.contentResolver.query(
+            MediaStore.Audio.Media.EXTERNAL_CONTENT_URI,
+            projection,
+            "${MediaStore.Audio.Media.DATA} LIKE ?",
+            arrayOf("%/SpatialFlow/%"),
+            "${MediaStore.Audio.Media.DATE_ADDED} DESC"
+        )?.use { c ->
+            val idCol = c.getColumnIndexOrThrow(MediaStore.Audio.Media._ID)
+            val titleCol = c.getColumnIndexOrThrow(MediaStore.Audio.Media.TITLE)
+            val artistCol = c.getColumnIndexOrThrow(MediaStore.Audio.Media.ARTIST)
+            val albumCol = c.getColumnIndexOrThrow(MediaStore.Audio.Media.ALBUM_ID)
+            val dataCol = c.getColumnIndexOrThrow(MediaStore.Audio.Media.DATA)
+            val durCol = c.getColumnIndexOrThrow(MediaStore.Audio.Media.DURATION)
+            val dateCol = c.getColumnIndexOrThrow(MediaStore.Audio.Media.DATE_ADDED)
+            while (c.moveToNext()) {
+                songs.add(
+                    SongItem(
+                        c.getLong(idCol),
+                        c.getString(titleCol) ?: "Unknown",
+                        c.getString(artistCol) ?: "Unknown Artist",
+                        c.getLong(albumCol),
+                        c.getString(dataCol),
+                        c.getLong(durCol),
+                        c.getLong(dateCol)
+                    )
+                )
+            }
+        }
+    } catch (_: Exception) {
+    }
+    return songs
+}
