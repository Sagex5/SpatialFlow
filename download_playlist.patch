+import androidx.compose.ui.unit.Dp
+import androidx.compose.ui.unit.dp
+import com.codetrio.spatialflow.model.SongItem
+import com.codetrio.spatialflow.util.PlaylistDownloader
+import com.codetrio.spatialflow.util.rememberAllDownloaded
+
+/**
+ * A small round "download playlist" button.
+ *  - Morphs its corners with a springy animation when pressed.
+ *  - Turns into a progress ring while the playlist downloads.
+ *  - Pops out of sight once every song is downloaded, and pops back in if a song is missing.
+ */
+@Composable
+fun PlaylistDownloadButton(
+    songs: List<SongItem>,
+    modifier: Modifier = Modifier,
+    size: Dp = 48.dp
+) {
+    val context = LocalContext.current
+    val haptic = LocalHapticFeedback.current
+    val allDownloaded = rememberAllDownloaded(songs)
+    val batch by PlaylistDownloader.batch.collectAsState()
+    val activeBatch = batch?.takeIf { b ->
+        songs.any { s -> s.videoId?.let { it in b.ids } == true }
+    }
+
+    AnimatedVisibility(
+        visible = songs.isNotEmpty() && (!allDownloaded || activeBatch != null),
+        modifier = modifier,
+        enter = fadeIn() + scaleIn(spring(dampingRatio = Spring.DampingRatioMediumBouncy)) + expandHorizontally(),
+        exit = fadeOut() + scaleOut() + shrinkHorizontally()
+    ) {
+        val interactionSource = remember { MutableInteractionSource() }
+        val isPressed by interactionSource.collectIsPressedAsState()
+        val corner by animateDpAsState(
+            targetValue = if (isPressed) 12.dp else size / 2,
+            animationSpec = spring(
+                dampingRatio = Spring.DampingRatioMediumBouncy,
+                stiffness = Spring.StiffnessMedium
+            ),
+            label = "DownloadButtonCorner"
+        )
+
+        FilledTonalIconButton(
+            onClick = {
+                if (activeBatch == null) {
+                    haptic.performHapticFeedback(HapticFeedbackType.LongPress)
+                    PlaylistDownloader.downloadAll(context, songs)
+                }
+            },
+            modifier = Modifier.size(size),
+            shape = RoundedCornerShape(corner),
+            interactionSource = interactionSource
+        ) {
+            Crossfade(targetState = activeBatch != null, label = "DownloadButtonIcon") { downloading ->
+                if (downloading) {
+                    val target = activeBatch?.let {
+                        if (it.total == 0) 0f else it.done.toFloat() / it.total
+                    } ?: 0f
+                    val progress by animateFloatAsState(targetValue = target.coerceAtLeast(0.06f), label = "DownloadProgress")
+                    CircularProgressIndicator(
+                        progress = { progress },
+                        modifier = Modifier.size(22.dp),
+                        strokeWidth = 2.5.dp
+                    )
+                } else {
+                    Icon(Icons.Default.Download, contentDescription = "Download playlist")
+                }
+            }
+        }
+    }
+}
