+/**
+ * Saves the current play queue as a named playlist in the app's library and,
+ * if you are signed in, optionally as a private playlist in your YouTube Music library.
+ */
+object QueuePlaylistSaver {
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+
+    fun save(context: Context, title: String, songs: List<SongItem>, syncToAccount: Boolean) {
+        val appContext = context.applicationContext
+        val queue = songs.toList()
+        scope.launch {
+            try {
+                // 1) Local playlist (shows up in Library > Playlists)
+                val dao = MusicDatabase.getDatabase(appContext).playlistDao()
+                val playlistId = dao.insertPlaylist(PlaylistEntity(title = title))
+                queue.forEachIndexed { index, song ->
+                    dao.insertPlaylistSong(song.toPlaylistSongEntity(playlistId, index))
+                }
+                var message = "Saved \"$title\" (${queue.size} songs)"
+
+                // 2) YouTube Music library (syncs with your signed-in Google account)
+                if (syncToAccount && AccountManager.isLoggedIn(appContext)) {
+                    val videoIds = queue.mapNotNull { it.videoId }.filter { it.isNotEmpty() }.distinct()
+                    if (videoIds.isEmpty()) {
+                        message += ". No online songs to sync to YouTube Music"
+                    } else {
+                        val created = YouTubeMusic.createPlaylist(
+                            title = title,
+                            description = "Saved from SpatialFlow",
+                            privacyStatus = "PRIVATE",
+                            videoIds = videoIds.take(50)
+                        )
+                        val ytId = created.getOrNull()
+                        if (ytId == null) {
+                            message += ". Couldn't save to YouTube Music: ${created.exceptionOrNull()?.message ?: "unknown error"}"
+                        } else {
+                            videoIds.drop(50).chunked(50).forEach { chunk ->
+                                YouTubeMusic.addToPlaylist(ytId, chunk)
+                            }
+                            message += " and added to your YouTube Music library"
+                        }
+                    }
+                }
+
+                withContext(Dispatchers.Main) { SnackbarController.showMessage(message) }
+            } catch (e: Exception) {
+                withContext(Dispatchers.Main) {
+                    SnackbarController.showMessage("Couldn't save playlist: ${e.message}")
+                }
+            }
+        }
+    }
+}
+
+@Composable
+fun SaveQueueAsPlaylistDialog(
+    songs: List<SongItem>,
+    onDismiss: () -> Unit
+) {
+    val context = LocalContext.current
+    val loggedIn = remember { AccountManager.isLoggedIn(context) }
+    var name by remember { mutableStateOf("") }
+    var syncToAccount by remember { mutableStateOf(loggedIn) }
+
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text("Save queue as playlist") },
+        text = {
+            Column {
+                OutlinedTextField(
+                    value = name,
+                    onValueChange = { name = it },
+                    label = { Text("Playlist name") },
+                    singleLine = true,
+                    modifier = Modifier.fillMaxWidth()
+                )
+                Spacer(modifier = Modifier.height(8.dp))
+                Text(
+                    "${songs.size} songs",
+                    style = MaterialTheme.typography.bodySmall,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant
+                )
+                Spacer(modifier = Modifier.height(8.dp))
+                if (loggedIn) {
+                    Row(
+                        modifier = Modifier
+                            .fillMaxWidth()
+                            .clickable { syncToAccount = !syncToAccount },
+                        verticalAlignment = Alignment.CenterVertically
+                    ) {
+                        Checkbox(checked = syncToAccount, onCheckedChange = { syncToAccount = it })
+                        Spacer(modifier = Modifier.width(4.dp))
+                        Text("Also save to my YouTube Music library", style = MaterialTheme.typography.bodyMedium)
+                    }
+                } else {
+                    Text(
+                        "Sign in with your Google account to also save playlists to your YouTube Music library.",
+                        style = MaterialTheme.typography.bodySmall,
+                        color = MaterialTheme.colorScheme.onSurfaceVariant
+                    )
+                }
+            }
+        },
+        confirmButton = {
+            Button(
+                enabled = name.isNotBlank() && songs.isNotEmpty(),
+                onClick = {
+                    QueuePlaylistSaver.save(context, name.trim(), songs, syncToAccount && loggedIn)
+                    onDismiss()
+                }
+            ) { Text("Save") }
+        },
+        dismissButton = { TextButton(onClick = onDismiss) { Text("Cancel") } }
+    )
+}
