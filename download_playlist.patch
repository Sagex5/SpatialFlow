+import com.codetrio.spatialflow.ui.SnackbarController
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import kotlinx.coroutines.withTimeoutOrNull
+import java.util.concurrent.atomic.AtomicBoolean
+
+/**
+ * Downloads a whole playlist by queueing its songs through the existing
+ * [SongDownloader], one at a time. Local songs and songs that are already
+ * downloaded are skipped.
+ */
+object PlaylistDownloader {
+
+    /** Progress of the playlist download that is currently running (null when idle). */
+    data class BatchState(val done: Int, val total: Int, val ids: Set<String>)
+
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private val running = AtomicBoolean(false)
+
+    private val _batch = MutableStateFlow<BatchState?>(null)
+    val batch: StateFlow<BatchState?> = _batch.asStateFlow()
+
+    fun downloadAll(context: Context, songs: List<SongItem>) {
+        if (!running.compareAndSet(false, true)) {
+            SnackbarController.showMessage("A playlist download is already running")
+            return
+        }
+        val appContext = context.applicationContext
+
+        scope.launch {
+            try {
+                val pending = songs
+                    .filter { !it.videoId.isNullOrEmpty() }
+                    .distinctBy { it.videoId }
+                    .filter { !SongDownloader.isSongDownloaded(appContext, it) }
+
+                if (pending.isEmpty()) {
+                    withContext(Dispatchers.Main) {
+                        SnackbarController.showMessage("Everything in this playlist is already downloaded")
+                    }
+                    return@launch
+                }
+
+                val ids = pending.mapNotNull { it.videoId }.toSet()
+                _batch.value = BatchState(0, pending.size, ids)
+                withContext(Dispatchers.Main) {
+                    SnackbarController.showMessage("Downloading ${pending.size} songs...")
+                }
+
+                pending.forEachIndexed { index, song ->
+                    val id = song.videoId
+                    if (id != null) {
+                        withContext(Dispatchers.Main) { SongDownloader.downloadSong(appContext, song) }
+                        awaitFinish(id)
+                    }
+                    _batch.value = BatchState(index + 1, pending.size, ids)
+                }
+
+                withContext(Dispatchers.Main) {
+                    SnackbarController.showMessage(
+                        "Playlist download finished",
+                        iconResId = R.drawable.ic_downloaded
+                    )
+                }
+            } finally {
+                _batch.value = null
+                running.set(false)
+            }
+        }
+    }
+
+    /** Waits until [id] has finished downloading (or has clearly stalled/failed). */
+    private suspend fun awaitFinish(id: String) {
+        // Give the download a moment to start.
+        withTimeoutOrNull(8_000L) { SongDownloader.downloadProgress.first { it.containsKey(id) } }
+
+        var last = -1
+        var lastChange = SystemClock.elapsedRealtime()
+        while (true) {
+            val progress = SongDownloader.downloadProgress.value[id] ?: return
+            val now = SystemClock.elapsedRealtime()
+            if (progress != last) {
+                last = progress
+                lastChange = now
+            } else if (now - lastChange > 120_000L) {
+                return // stalled or failed: move on to the next song
+            }
+            delay(500L)
+        }
+    }
+
+    /** True when every online song in [songs] is already downloaded (local songs count as done). */
+    fun allDownloaded(context: Context, songs: List<SongItem>): Boolean =
+        songs.all { it.videoId.isNullOrEmpty() || SongDownloader.isSongDownloaded(context, it) }
+}
+
+/**
+ * Compose helper: true when every song in [songs] is downloaded (also true until the first
+ * check finishes). Re-checks whenever a download starts or finishes, so download buttons can
+ * hide themselves and reappear if a song is missing.
+ */
+@Composable
+fun rememberAllDownloaded(songs: List<SongItem>): Boolean {
+    val appContext = LocalContext.current.applicationContext
+    var all by remember(songs) { mutableStateOf(true) }
+    LaunchedEffect(songs) {
+        SongDownloader.downloadProgress.collect {
+            all = withContext(Dispatchers.IO) { PlaylistDownloader.allDownloaded(appContext, songs) }
+        }
+    }
+    return all
+}
