+@Composable
+private fun DockItem(
+    visible: Boolean,
+    index: Int,
+    content: @Composable () -> Unit
+) {
+    AnimatedVisibility(
+        visible = visible,
+        enter = fadeIn(tween(180, delayMillis = index * 40)) +
+            scaleIn(spring(dampingRatio = Spring.DampingRatioMediumBouncy), initialScale = 0.6f) +
+            expandHorizontally(),
+        exit = fadeOut(tween(100)) + scaleOut(targetScale = 0.6f) + shrinkHorizontally()
+    ) {
+        content()
+    }
+}
