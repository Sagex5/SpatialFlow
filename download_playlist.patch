+    private fun buildResult(track: TrackMetadata, trimmed: String): LyricsResult {
+        val result = LyricsResult(
+            providerName = getName(),
+            matchedTitle = track.cleanedTitle,
+            matchedArtist = track.cleanedArtist,
+            matchedDuration = track.durationMs / 1000f
+        )
+        if (trimmed.matches("(?s).*\\[\\d{2}:\\d{2}\\.\\d{2,3}].*".toRegex())) {
+            result.setSyncedLyrics(trimmed)
+        }
+        result.plainLyrics = trimmed.replace("\\[\\d{2}:\\d{2}\\.\\d{2,3}]".toRegex(), "").trim()
+        return result
+    }
+
+    private fun readOpusLyrics(path: String): String? {
+        val lower = path.lowercase()
+        if (!(lower.endsWith(".opus") || lower.endsWith(".ogg") || lower.endsWith(".oga"))) return null
+        return try {
+            java.io.RandomAccessFile(path, "r").use { raf ->
+                val tags = readOpusTagsPacket(raf) ?: return null
+                parseLyricsComment(tags)
+            }
+        } catch (e: Exception) {
+            Log.w(TAG, "Could not read Opus tags: ${e.message}")
+            null
+        }
+    }
+
+    /** Reassembles the second Ogg packet (OpusTags), which may span several pages. */
+    private fun readOpusTagsPacket(raf: java.io.RandomAccessFile): ByteArray? {
+        val out = java.io.ByteArrayOutputStream()
+        var packetIndex = 0
+        val header = ByteArray(27)
+        while (raf.filePointer + 27 <= raf.length()) {
+            raf.readFully(header)
+            if (header[0] != 'O'.code.toByte() || header[1] != 'g'.code.toByte() ||
+                header[2] != 'g'.code.toByte() || header[3] != 'S'.code.toByte()
+            ) return null
+            val segmentCount = header[26].toInt() and 0xFF
+            val table = ByteArray(segmentCount)
+            raf.readFully(table)
+            for (segment in table) {
+                val length = segment.toInt() and 0xFF
+                val chunk = ByteArray(length)
+                raf.readFully(chunk)
+                if (packetIndex == 1) {
+                    out.write(chunk)
+                    if (out.size() > 8 * 1024 * 1024) return null
+                }
+                if (length < 255) {
+                    if (packetIndex == 1) return out.toByteArray()
+                    packetIndex++
+                }
+            }
+        }
+        return null
+    }
+
+    private fun parseLyricsComment(data: ByteArray): String? {
+        if (data.size < 16 || String(data, 0, 8, Charsets.US_ASCII) != "OpusTags") return null
+        val buf = java.nio.ByteBuffer.wrap(data).order(java.nio.ByteOrder.LITTLE_ENDIAN)
+        buf.position(8)
+        val vendorLength = buf.int
+        if (vendorLength < 0 || vendorLength > buf.remaining()) return null
+        buf.position(buf.position() + vendorLength)
+        if (buf.remaining() < 4) return null
+        val count = buf.int
+        for (i in 0 until count) {
+            if (buf.remaining() < 4) return null
+            val length = buf.int
+            if (length < 0 || length > buf.remaining()) return null
+            val bytes = ByteArray(length)
+            buf.get(bytes)
+            val comment = String(bytes, Charsets.UTF_8)
+            val eq = comment.indexOf('=')
+            if (eq > 0 && comment.substring(0, eq).equals("LYRICS", ignoreCase = true)) {
+                return comment.substring(eq + 1)
+            }
+        }
+        return null
+    }
 }
